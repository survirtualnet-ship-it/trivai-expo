# Copiar a .env.local para desarrollo local
# En Vercel: Project Settings → Environment Variables (build time)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Maps (JavaScript API, Static Maps, Geocoding en nativo)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key

# Server-only for Vercel /api/google-places (prefer this over exposing client key)
# GOOGLE_PLACES_KEY=your_google_places_key

# URL pública de esta app (share links, PWA, serverless /api/*)
EXPO_PUBLIC_APP_URL=https://trivai-expo.vercel.app

# Opcional: ExchangeRate-API con key (https://www.exchangerate-api.com)
# Sin key usa el endpoint open access: https://open.er-api.com/v6/latest/USD
# EXPO_PUBLIC_EXCHANGE_RATE_API_KEY=your_exchangerate_api_key

# Solo scripts locales (NO commitear, NO usar EXPO_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
